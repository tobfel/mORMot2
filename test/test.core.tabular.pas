unit test.core.tabular;

interface

{$I ..\src\mormot.defines.inc}

uses
  sysutils,
  mormot.core.base,
  mormot.core.os,
  mormot.core.unicode,
  mormot.core.text,
  mormot.core.datetime,
  mormot.core.rtti,
  mormot.core.data,
  mormot.core.variants,
  mormot.core.json,
  mormot.core.log,
  mormot.core.perf,
  mormot.core.test,
  mormot.core.tabular,
  mormot.core.csv,
  mormot.core.xlsx,
  mormot.db.core,
  mormot.db.sql,
  mormot.db.raw.sqlite3,
  mormot.db.sql.sqlite3,
  mormot.db.tabular;

type
  /// regression tests for CSV/XLSX tabular data process over TDocVariant
  TTestCoreTabular = class(TSynTestCase)
  protected
    fFixtures: TFileName;
    function Fixtures: boolean;
    function ExpectError(Doc: TTabularDocument; const Data: RawByteString): boolean;
    function ExpectRaise(const Props: TSqlDBConnectionProperties;
      const Rows: RawUtf8; const Expected: RawUtf8 = ''): boolean;
  published
    /// shared number/date conversion functions
    procedure Conversions;
    /// RFC 4180 CSV reading
    procedure CsvReading;
    /// RFC 4180 CSV writing
    procedure CsvWriting;
    /// XLSX reading of real-world files
    procedure XlsxReading;
    /// XLSX writing and round-trip
    procedure XlsxWriting;
    /// columns inference and import/export via mormot.db.sql
    procedure SqlDB;
    /// CSV/XLSX/SQL speed
    procedure Benchmark;
  end;


implementation

function J(const v: variant): RawUtf8;
begin
  result := _Safe(v)^.ToJson;
end;

// normalize an ASCII-only JSON (with \uXXXX escapes) as J() would output it
function JE(const json: RawUtf8): RawUtf8;
begin
  result := J(_Json(json, JSON_FAST_FLOAT));
end;

function DateVariant(dt: TDateTime): variant;
begin
  VarClear(result);
  TVarData(result).VType := varDate;
  TVarData(result).VDate := dt;
end;


function CurrVariant(c: currency): variant;
begin
  result := c;
end;


{ TTestCoreTabular }

function TTestCoreTabular.Fixtures: boolean;
var
  dir: TFileName;
  i: PtrInt;
begin
  // ex/tabular/fixtures holds some .xlsx files generated by other tools
  if fFixtures = '' then
  begin
    fFixtures := '-';
    dir := Executable.ProgramFilePath;
    for i := 1 to 6 do
    begin
      if DirectoryExists(MakePath([dir, 'ex', 'tabular', 'fixtures'])) then
      begin
        fFixtures := MakePath([dir, 'ex', 'tabular', 'fixtures'], true);
        break;
      end;
      dir := ExtractFilePath(ExcludeTrailingPathDelimiter(dir));
    end;
    if fFixtures = '-' then
      AddConsole('ex/tabular/fixtures not found: real-world XLSX skipped');
  end;
  result := fFixtures <> '-';
end;

function TTestCoreTabular.ExpectError(Doc: TTabularDocument;
  const Data: RawByteString): boolean;
var
  v: variant;
begin
  TSynLog.Family.ExceptionIgnoreCurrentThread := true;
  try
    result := not Doc.TryLoad(Data, v) and
              (Doc.LastError <> '');
  finally
    TSynLog.Family.ExceptionIgnoreCurrentThread := false;
  end;
end;

function TTestCoreTabular.ExpectRaise(const Props: TSqlDBConnectionProperties;
  const Rows, Expected: RawUtf8): boolean;
begin
  result := false;
  TSynLog.Family.ExceptionIgnoreCurrentThread := true;
  try
    try
      TabularToSqlDB(Props, 'import', _JsonFast(Rows), []);
    except
      on E: ETabularSql do
        result := (Expected = '') or
                  (PosEx(Expected, StringToUtf8(E.Message)) > 0);
    end;
  finally
    TSynLog.Family.ExceptionIgnoreCurrentThread := false;
  end;
end;

procedure TTestCoreTabular.Conversions;
var
  v: variant;
  i64: Int64;
  d: double;
  dt: TDateTime;

  function Num(const Text: RawUtf8; Sep: AnsiChar = '.'): RawUtf8;
  begin
    if TabularTextToNumber(pointer(Text), length(Text), v, true, Sep) then
      result := copy(J(_ArrFast([v])), 2, 30) // '[1.5]' -> '1.5]'
    else
      result := '!';
  end;

begin
  CheckEqual(Num('42'), '42]');
  CheckEqual(Num('-1.5'), '-1.5]');
  CheckEqual(Num('1e3'), '1000]');
  CheckEqual(Num('1,5', ','), '1.5]');
  CheckEqual(Num('1.5', ','), '1.5]');
  CheckEqual(Num('1.234,5', ','), '!', 'thousands');
  CheckEqual(Num('007'), '!', 'leading zero');
  CheckEqual(Num(' 1'), '!');
  CheckEqual(Num('1.2.3'), '!');
  CheckEqual(Num('1e'), '!');
  CheckEqual(Num(''), '!');
  CheckEqual(Num('12345678901234567890'), '!', 'huge integer');
  CheckEqual(Num('9223372036854775807'), '9223372036854775807]', 'max Int64');
  Check(TabularTextToNumber('12', 1, v) and (v = 1), 'Len');
  Check(TabularToInt64(Null, i64) = tcNull);
  Check(TabularToInt64('', i64) = tcNull);
  Check((TabularToInt64('7', i64) = tcValue) and (i64 = 7));
  Check((TabularToInt64(true, i64) = tcValue) and (i64 = 1));
  Check((TabularToInt64(2.0, i64) = tcValue) and (i64 = 2));
  Check(TabularToInt64(2.5, i64) = tcInvalid);
  Check(TabularToInt64('1.5', i64) = tcInvalid);
  Check(TabularToInt64('seven', i64) = tcInvalid);
  Check((TabularToDouble('-0.25', d) = tcValue) and (d = -0.25));
  Check((TabularToDouble(3, d) = tcValue) and (d = 3));
  Check(TabularToDouble('x', d) = tcInvalid);
  Check((TabularToDateTime('2024-02-29T13:45:30', dt) = tcValue) and
        (DateTimeToIso8601Text(dt) = '2024-02-29T13:45:30'));
  Check((TabularToDateTime(DateVariant(EncodeDate(2025, 1, 1)), dt) = tcValue) and
        (dt = EncodeDate(2025, 1, 1)));
  Check((TabularToDateTime(45000, dt) = tcValue) and (dt = 45000));
  Check(TabularToDateTime('31.01.2024', dt) = tcInvalid, 'not ISO-8601');
  Check(TabularToDateTime('', dt) = tcNull);
end;

procedure TTestCoreTabular.CsvReading;
var
  c: TCsvDocument;
  v: variant;
begin
  // RFC 4180 section 2 examples
  CheckEqual(CsvToJson('aaa,bbb,ccc'#13#10'zzz,yyy,xxx'#13#10, []),
    '[["aaa","bbb","ccc"],["zzz","yyy","xxx"]]', 'rfc 2.1');
  CheckEqual(CsvToJson('aaa,bbb,ccc'#13#10'zzz,yyy,xxx', []),
    '[["aaa","bbb","ccc"],["zzz","yyy","xxx"]]', 'rfc 2.2 no final CRLF');
  CheckEqual(CsvToJson('field_name,field_name2'#13#10'aaa,bbb', [tboHeader]),
    '[{"field_name":"aaa","field_name2":"bbb"}]', 'rfc 2.3 header');
  CheckEqual(CsvToJson('"aaa","bbb","ccc"'#13#10, []),
    '[["aaa","bbb","ccc"]]', 'rfc 2.5 quoted');
  CheckEqual(CsvToJson('"aaa","b'#13#10'bb","ccc"'#13#10'zzz,yyy,xxx', []),
    '[["aaa","b\r\nbb","ccc"],["zzz","yyy","xxx"]]', 'rfc 2.6 CRLF in quotes');
  CheckEqual(CsvToJson('"aaa","b""bb","ccc"', []),
    '[["aaa","b\"bb","ccc"]]', 'rfc 2.7 escaped quote');
  // line endings and empty fields
  CheckEqual(CsvToJson('a,b'#10'1,2'#13'3,4', []),
    '[["a","b"],["1","2"],["3","4"]]', 'LF and CR line endings');
  CheckEqual(CsvToJson('a,,c,'#13#10',,,', []),
    '[["a","","c",""],["","","",""]]', 'empty fields');
  CheckEqual(CsvToJson('a,b'#13#10#13#10'c,d'#13#10, [tboSkipEmptyRows]),
    '[["a","b"],["c","d"]]', 'skip empty rows');
  CheckEqual(CsvToJson('a,b'#13#10#13#10'c,d'#13#10, []),
    '[["a","b"],[""],["c","d"]]', 'keep empty rows');
  CheckEqual(CsvToJson('', []), '[]', 'void input');
  // type guessing
  CheckEqual(CsvToJson('1,-2,3.5,1e3,007,"42",true,FALSE,1.2.3,' +
    '12345678901234567890,-,1.5e', [tboGuessTypes]),
    '[[1,-2,3.5,1000,"007","42",true,false,"1.2.3","12345678901234567890",' +
    '"-","1.5e"]]', 'guess types');
  CheckEqual(CsvToJson('a,b'#13#10',x', [tboHeader, tboEmptyAsNull]),
    '[{"a":null,"b":"x"}]', 'empty as null');
  CheckEqual(CsvToJson('a,b'#13#10'"",x', [tboHeader, tboEmptyAsNull]),
    '[{"a":"","b":"x"}]', 'quoted "" is not null');
  CheckEqual(CsvToJson(' a , b '#13#10' 1 ,  2', [tboHeader, tboTrimValues,
    tboGuessTypes]), '[{"a":1,"b":2}]', 'trim values');
  // header handling
  CheckEqual(CsvToJson('a,a,,b'#13#10'1,2,3,4,5'#13#10'6', [tboHeader]),
    '[{"a":"1","a_2":"2","Col3":"3","b":"4","Col5":"5"},' +
    '{"a":"6","a_2":"","Col3":"","b":""}]', 'ragged rows and unique names');
  // delimiters, BOM, encodings
  CheckEqual(CsvToJson(HexToBin('efbbbf') + 'x;y'#13#10'1;2', [tboHeader], ';'),
    '[{"x":"1","y":"2"}]', 'utf-8 bom + semicolon');
  CheckEqual(CsvToJson('x'#9'y'#13#10'1'#9'2', [tboHeader], #0),
    '[{"x":"1","y":"2"}]', 'auto-detect tab');
  CheckEqual(CsvToJson('"a;b";c;d'#13#10'1;2;3', [], #0),
    '[["a;b","c","d"],["1","2","3"]]', 'auto-detect semicolon');
  c := TCsvDocument.Create([tboHeader, tboGuessTypes]);
  try
    // Excel German export: sep=; hint line, CP-1252 and decimal comma
    c.DecimalSeparator := ',';
    c.Load(HexToBin('7365703d3b0d0a4e616d653b4265747261673b446174756d0d0a4dfc6c' +
      '6c65723b312c353b33312e30312e323032340d0a4772fcdf653b2d322c32353b30312e' +
      '30322e323032340d0a'), v);
    CheckEqual(J(v), JE('[{"Name":"M\u00fcller","Betrag":1.5,"Datum":' +
      '"31.01.2024"},{"Name":"Gr\u00fc\u00dfe","Betrag":-2.25,"Datum":' +
      '"01.02.2024"}]'), 'sep=; line + cp1252 + decimal comma');
    Check(c.UsedDelimiter = ';', 'UsedDelimiter');
    CheckEqual(c.LoadToJson('sep=;'#13#10'n'#13#10'1.234,5'), '[{"n":"1.234,5"}]',
      'thousands separator kept as text');
    c.Delimiter := #0;
    c.Load(HexToBin('fffe610009006200' + '0d000a00c4000900ac200d000a00'), v);
    CheckEqual(J(v), JE('[{"a":"\u00c4","b":"\u20ac"}]'), 'utf-16 le bom');
    c.Load(HexToBin('feff006100090062' + '000d000a00c4000920ac000d000a'), v);
    CheckEqual(J(v), JE('[{"a":"\u00c4","b":"\u20ac"}]'), 'utf-16 be bom');
    // as written by the Python csv module
    c.Delimiter := ',';
    c.DecimalSeparator := '.';
    c.Options := [tboHeader];
    c.Load('id,text,num'#13#10'1,"He said ""hi""",1.5'#13#10'2,"multi'#13#10 +
      'line",-3'#13#10'3,"a,b;c",'#13#10'4,,007'#13#10, v);
    CheckEqual(J(v), '[{"id":"1","text":"He said \"hi\"","num":"1.5"},' +
      '{"id":"2","text":"multi\r\nline","num":"-3"},' +
      '{"id":"3","text":"a,b;c","num":""},{"id":"4","text":"","num":"007"}]',
      'python csv module output');
    c.MaxRows := 2;
    c.Load('a'#13#10'1'#13#10'2'#13#10'3'#13#10, v);
    CheckEqual(_Safe(v)^.Count, 2, 'MaxRows');
    c.MaxRows := 0;
    // lenient vs strict
    c.Options := [];
    CheckEqual(c.LoadToJson('a"b,"c"d,"e'), '[["a\"b","cd","e"]]', 'lenient');
    c.CsvOptions := [csoStrict];
    Check(ExpectError(c, 'a"b,c'), 'strict bare quote');
    Check(ExpectError(c, '"c"d,e'), 'strict char after quote');
    Check(ExpectError(c, '"abc'), 'strict unterminated');
    Check(ExpectError(c, 'a,b'#13#10'c'), 'strict field count');
    Check(not ExpectError(c, 'a,b'#13#10'c,d'#13#10), 'strict valid');
  finally
    c.Free;
  end;
end;

procedure TTestCoreTabular.CsvWriting;
var
  c: TCsvDocument;
  v: variant;
  s: RawByteString;
begin
  v := _JsonFast('[{"a":1,"b":"x,y","c":"say \"hi\""},{"b":"multi'#13#10'line",' +
    '"d":true},{"a":2.5,"c":null,"e":" pad "}]');
  CheckEqual(VariantToCsv(v),
    'a,b,c,d,e'#13#10'1,"x,y","say ""hi""",,'#13#10',"multi'#13#10'line",,true,' +
    #13#10'2.5,,,," pad "'#13#10, 'union of columns + RFC quoting');
  CheckEqual(VariantToCsv(_JsonFast('[[1,"a"],["b"]]'), []),
    '1,a'#13#10'b'#13#10, 'array rows');
  CheckEqual(JsonToCsv('[{"x":1}]', [tboHeader], ';'), 'x'#13#10'1'#13#10, 'json');
  c := TCsvDocument.Create;
  try
    c.Columns := TRawUtf8DynArrayFrom(['c', 'a']);
    c.Delimiter := ';';
    c.DecimalSeparator := ',';
    c.Quoting := cqNonNumeric;
    c.CsvOptions := [csoNoFinalLineBreak, csoEscapeFormulas, csoWriteSepLine];
    c.LineBreak := #10;
    s := c.Save(_JsonFast('[{"a":1.25,"c":"=SUM(A1)","z":0},{"a":3}]'));
    CheckEqual(s, 'sep=;'#10'"c";"a"'#10'"''=SUM(A1)";1,25'#10';3',
      'columns, nonnumeric quoting, formula escape');
    c.Columns := nil;
    c.Delimiter := ',';
    c.DecimalSeparator := '.';
    c.Quoting := cqMinimal;
    c.CsvOptions := [csoWriteBom];
    c.LineBreak := #13#10;
    s := c.Save(_JsonFast('[{"n":"\u00c4"}]'));
    CheckEqualHex(s, 'efbbbf6e0d0ac3840d0a', 'bom');
    c.CsvOptions := [];
    c.CodePage := CP_WINANSI;
    s := c.Save(_JsonFast('[{"n":"\u00c4\u20ac"}]'));
    CheckEqualHex(s, '6e0d0ac4800d0a', 'cp1252 output');
    c.CodePage := 0;
    // date/time and currency values
    v := _Arr([_ObjFast(['d', DateVariant(EncodeDate(2024, 12, 24) +
      EncodeTime(18, 30, 0, 0)), 'c', CurrVariant(1.5), 'i', CurrVariant(2)])], JSON_FAST);
    CheckEqual(c.Save(v), 'd,c,i'#13#10'2024-12-24T18:30:00,1.5,2'#13#10,
      'date and currency');
    // round-trip with tboEmptyAsNull keeps "" vs null distinction
    c.Options := [tboHeader, tboEmptyAsNull, tboGuessTypes];
    s := c.Save(_JsonFast('[{"a":"","b":null,"c":"007","d":7}]'));
    CheckEqual(s, 'a,b,c,d'#13#10'"",,007,7'#13#10, 'null vs void string');
    c.Load(s, v);
    CheckEqual(J(v), '[{"a":"","b":null,"c":"007","d":7}]', 'csv round-trip');
  finally
    c.Free;
  end;
end;

procedure TTestCoreTabular.XlsxReading;
var
  x: TXlsxDocument;
  v: variant;
  dt: TDateTime;
begin
  x := TXlsxDocument.Create([tboHeader, tboEmptyAsNull]);
  try
    Check(ExpectError(x, 'not a zip file at all, just text'), 'invalid input');
    if not Fixtures then
      exit;
    CheckEqual(RawUtf8ArrayToCsv(x.GetSheetNames(
      StringFromFile(fFixtures + 'openpyxl.xlsx'))),
      'Data,Zweite Tabelle,Hidden', 'sheet names');
    x.LoadFromFile(fFixtures + 'openpyxl.xlsx', v);
    CheckEqual(J(v),
      '[{"id":1,"name":"Alice","amount":1234.5,"flag":true,"date":"2024-01-31",' +
      '"datetime":"2024-02-29T13:45:30","time":"T08:30:00","pct":0.25,' +
      '"formula":null},' + // formula with no cached value
      '{"id":2,"name":"Bob\nZeile 2","amount":-0.001,"flag":false,"date":' +
      '"1900-01-01","datetime":"1999-12-31T23:59:59","time":"T23:00:00",' +
      '"pct":1,"formula":null},' +
      '{"id":3,"name":"  spaces  ","amount":12345678901234,"flag":null,' +
      '"date":null,"datetime":null,"time":null,"pct":null,"formula":null},' +
      '{"id":null,"name":null,"amount":null,"flag":null,"date":null,' + // gap
      '"datetime":null,"time":null,"pct":null,"formula":null},' +
      '{"id":6,"name":null,"amount":"sparse","flag":null,"date":null,' +
      '"datetime":null,"time":null,"pct":null,"formula":null}]',
      'openpyxl data sheet');
    Check(TabularIsDate(_Safe(_Safe(v)^.Values[0])^.Value['date'], dt) and
      (dt = EncodeDate(2024, 1, 31)), 'date is varDate');
    x.SheetName := 'zweite tabelle';
    x.LoadFromFile(fFixtures + 'openpyxl.xlsx', v);
    CheckEqual(J(v), '[{"a":"x","b":1.5}]', 'sheet by name');
    x.SheetName := '';
    x.LoadSheetsFromFile(fFixtures + 'openpyxl.xlsx', v, {hidden=}false);
    CheckEqual(RawUtf8ArrayToCsv(_Safe(v)^.GetNames), 'Data,Zweite Tabelle',
      'LoadSheets without hidden');
    x.LoadFromFile(fFixtures + 'date1904.xlsx', v);
    CheckEqual(J(v), '[{"d":"2020-05-17"}]', '1904 date system');
    Check(x.Date1904, 'Date1904 property');
    // file written by our TXlsxDocument then re-saved by LibreOffice Calc
    x.LoadFromFile(fFixtures + 'libreoffice.xlsx', v);
    CheckEqual(J(v), JE(
      '[{"Name":"M\u00fcller","Age":42,"Price":3.25,"Ok":true,"When":' +
      '"2024-02-29","Extra":null,"Big":null},{"Name":"a \"q\" <b> & _x0041_ ' +
      '\u0001ctl","Age":-7,"Price":0.001,"Ok":false,"When":' +
      '"1900-01-01T12:00:00","Extra":"{\"nested\":[1,2]}","Big":null},' +
      '{"Name":" lead","Age":null,"Price":null,"Ok":null,"When":null,' +
      '"Extra":null,"Big":1234567890123456}]'), 'libreoffice re-saved file');
    x.Options := [tboHeader];
    x.LoadFromFile(fFixtures + 'handmade.xlsx', v);
    CheckEqual(J(v),
      '[{"col A":"","col B":"","col C":"","col A_2":""},' + // gap row 2
      '{"col A":"Bold and plain","col B":"line1\r\nline2 _x0041_ <tag>",' +
      '"col C":"","col A_2":"ab"},' +
      '{"col A":true,"col B":"#DIV/0!","col C":0.0015,"col A_2":-42,"Col5":7}]',
      'handmade: ns prefix, inlineStr, rich text, rPh, escapes, types');
    x.Options := [];
    x.LoadFromFile(fFixtures + 'handmade.xlsx', v);
    CheckEqual(_Safe(v)^.Count, 4, 'empty row 2 kept without tboSkipEmptyRows');
    x.SheetName := 'missing';
    Check(ExpectError(x, StringFromFile(fFixtures + 'openpyxl.xlsx')),
      'missing sheet');
  finally
    x.Free;
  end;
end;

procedure TTestCoreTabular.XlsxWriting;
var
  x: TXlsxDocument;
  v, w: variant;
  bin: RawByteString;
begin
  v := _JsonFast('[{"Name":"M\u00fcller","Age":42,"Price":3.25,"Ok":true},' +
    '{"Name":"a \"q\" <b> & _x0041_ \u0001ctl","Age":-7,"Price":1e-3,' +
    '"Ok":false,"Extra":{"nested":[1,2]}},{"Name":" lead",' +
    '"Big":1234567890123456}]');
  _Safe(v)^.Values[0].When := DateVariant(EncodeDate(2024, 2, 29));
  _Safe(v)^.Values[1].When := DateVariant(EncodeDate(1900, 1, 1) +
    EncodeTime(12, 0, 0, 0));
  x := TXlsxDocument.Create([tboHeader, tboEmptyAsNull]);
  try
    x.XlsxOptions := [xoHeaderBold, xoFreezeHeader, xoAutoFilter, xoAutoWidth];
    bin := x.Save(v);
    x.Load(bin, w);
    CheckEqual(J(w), JE(
      '[{"Name":"M\u00fcller","Age":42,"Price":3.25,"Ok":true,"When":' +
      '"2024-02-29","Extra":null,"Big":null},' +
      '{"Name":"a \"q\" <b> & _x0041_ \u0001ctl","Age":-7,"Price":0.001,' +
      '"Ok":false,"When":"1900-01-01T12:00:00","Extra":"{\"nested\":[1,2]}",' +
      '"Big":null},' +
      '{"Name":" lead","Age":null,"Price":null,"Ok":null,"When":null,' +
      '"Extra":null,"Big":1234567890123456}]'), 'xlsx round-trip');
    // several sheets as a TDocVariant object, with sanitized names
    bin := x.SaveJson('{"Sales/2024":[{"a":1}],"Sales/2024 ":[[1,2],[3]],' +
      '"[]":[]}');
    CheckEqual(RawUtf8ArrayToCsv(x.GetSheetNames(bin)),
      'Sales_2024,Sales_2024 (2),__', 'sheet names sanitized');
    x.LoadSheets(bin, w);
    // [[1,2],[3]] with tboHeader: first row [1,2] are the column names
    CheckEqual(J(w), '{"Sales_2024":[{"a":1}],"Sales_2024 (2)":[{"1":3,' +
      '"2":null}],"__":[]}', 'LoadSheets');
    x.Options := [];
    x.SheetName := 'Matrix';
    bin := x.SaveJson('[[1,"two",3.5],[],[null,true]]');
    x.SheetName := '';
    x.Load(bin, w);
    CheckEqual(J(w), '[[1,"two",3.5],[""],["",true]]', 'array rows');
    CheckEqual(XlsxColumnName(0) + XlsxColumnName(25) + XlsxColumnName(26) +
      XlsxColumnName(701) + XlsxColumnName(702), 'AZAAZZAAA', 'column names');
    CheckEqual(XlsxColumnIndex('XFD1048576', 10), 16383, 'column index');
    Check(XlsxIsDateFormat('dd/mm/yyyy') and
          XlsxIsDateFormat('[h]:mm') and
          not XlsxIsDateFormat('0.00E+00') and
          not XlsxIsDateFormat('"Day "0') and
          not XlsxIsDateFormat('[Red]#,##0') and
          not XlsxIsDateFormat('General'), 'date formats');
  finally
    x.Free;
  end;
end;

function SampleRows: variant;
begin
  result := _Json('[' +
    '{"id":1,"first name":"M\u00fcller","amount":1,"ok":true,"order":null,' +
    '"1st":"a","when":null,"note":"short"},' +
    '{"id":2,"first name":"O''Brien","amount":2.5,"ok":false,"order":"x",' +
    '"1st":5,"when":null,"note":"' + RawUtf8OfChar('x', 300) + '"},' +
    '{"id":3,"first name":null,"amount":3.14159,"ok":true,"order":"",' +
    '"1st":"c","when":null}]', JSON_FAST_FLOAT);
  _Safe(_Safe(result)^.Values[0])^.Values[6] :=
    DateVariant(EncodeDate(2024, 2, 29) + EncodeTime(13, 45, 30, 0));
  _Safe(_Safe(result)^.Values[1])^.Values[6] := DateVariant(EncodeDate(2025, 1, 1));
end;

procedure TTestCoreTabular.SqlDB;
var
  cols: TTabularColumns;
  props: TSqlDBSQLite3ConnectionProperties;
  rows, res: variant;
  s, expected: RawUtf8;
  i: PtrInt;
begin
  // column layout inference
  cols := TabularColumns(SampleRows);
  s := '';
  for i := 0 to length(cols) - 1 do
    s := Make([s, cols[i].Name, '/', cols[i].SqlName, '=',
      ToText(cols[i].FieldType)^, ':', cols[i].MaxLength, ':',
      ord(cols[i].HasNull), ' ']);
  CheckEqual(s, 'id/id=ftInt64:0:0 first name/first_name=ftUtf8:7:1 ' +
    'amount/amount=ftDouble:0:0 ok/ok=ftInt64:0:0 order/order=ftUtf8:1:1 ' +
    '1st/_1st=ftUtf8:1:0 when/when=ftDate:0:1 note/note=ftUtf8:300:1 ',
    'TabularColumns');
  cols := TabularColumns(_JsonFast('[[1,"a"],[2.5],[3,"bb",true]]'));
  CheckEqual(Make([length(cols), cols[0].Name, ToText(cols[0].FieldType)^,
    cols[2].Name, ord(cols[1].HasNull), ord(cols[2].HasNull)]),
    '3Col1ftCurrencyCol311', 'array rows');
  CheckEqual(TabularSqlName(HexToBin('53747261c39f65204e722e')), 'Stra__e_Nr_',
    'sql name utf-8');
  // import/export via SQLite3
  props := TSqlDBSQLite3ConnectionProperties.Create(SQLITE_MEMORY_DATABASE_NAME,
    '', '', '');
  try
    rows := SampleRows;
    CheckEqual(TabularSqlCreate(props, 'import', _Safe(rows)^),
      'CREATE TABLE import (id INTEGER,first_name TEXT COLLATE SYSTEMNOCASE,' +
      'amount FLOAT,ok INTEGER,order_ TEXT COLLATE SYSTEMNOCASE,' +
      '_1st TEXT COLLATE SYSTEMNOCASE,when_ TEXT COLLATE ISO8601,' +
      'note TEXT COLLATE SYSTEMNOCASE)', 'SqlCreate with reserved words');
    CheckEqual(TabularToSqlDB(props, 'import', rows), 3, 'insert count');
    expected := JE('[' +
      '{"id":1,"first_name":"M\u00fcller","amount":1,"ok":1,"order_":null,' +
      '"_1st":"a","when_":"2024-02-29T13:45:30","note":"short"},' +
      '{"id":2,"first_name":"O''Brien","amount":2.5,"ok":0,"order_":"x",' +
      '"_1st":"5","when_":"2025-01-01","note":"' + RawUtf8OfChar('x', 300) +
      '"},{"id":3,"first_name":null,"amount":3.14159,"ok":1,"order_":"",' +
      '"_1st":"c","when_":null,"note":null}]');
    res := SqlDBToTabular(props, 'select * from import order by id', []);
    CheckEqual(J(res), expected, 'select back');
    // append into the existing table, matching by original or SQL names
    CheckEqual(TabularToSqlDB(props, 'import',
      _JsonFast('[{"id":"4","amount":"7","first name":"x"}]'), []), 1,
      'existing table + text to number conversion');
    CheckEqual(J(SqlDBToTabular(props,
      'select id,amount,first_name from import where id=?', [4])),
      '[{"id":4,"amount":7,"first_name":"x"}]', 'converted values');
    Check(ExpectRaise(props, '[{"id":5,"zzz":1}]'), 'unknown column raises');
    CheckEqual(TabularToSqlDB(props, 'import', _JsonFast('[{"id":5,"zzz":1}]'),
      [tsoIgnoreUnknownColumns]), 1, 'tsoIgnoreUnknownColumns');
    Check(ExpectRaise(props, '[{"id":6},{"id":"seven"}]', 'row 2'),
      'conversion error with row number');
    CheckEqual(J(SqlDBToTabular(props, 'select count(*) as n from import', [])),
      '[{"n":5}]', 'rollback on error');
    // tsoDeleteFirst + per-row prepared INSERT path
    CheckEqual(TabularToSqlDB(props, 'import', rows, [tsoDeleteFirst, tsoNoBatch]),
      3, 'no batch count');
    res := SqlDBToTabular(props, 'select * from import order by id', []);
    CheckEqual(J(res), expected, 'no batch data');
    // CSV -> SQL -> XLSX full chain
    with TCsvDocument.CreateDelimiter(';', [tboHeader, tboGuessTypes]) do
    try
      DecimalSeparator := ',';
      Load('Art.Nr;Bezeichnung;Preis'#13#10'0815;Schraube;0,25'#13#10 +
        '4711;Mutter;1,5'#13#10, rows);
    finally
      Free;
    end;
    TabularToSqlDB(props, 'artikel', rows);
    res := SqlDBToTabular(props, 'select * from artikel', []);
    CheckEqual(J(res), '[{"Art_Nr":"0815","Bezeichnung":"Schraube",' +
      '"Preis":0.25},{"Art_Nr":"4711","Bezeichnung":"Mutter","Preis":1.5}]',
      'csv -> sql');
    CheckEqual(J(XlsxToVariant(VariantToXlsx(res))), J(res), 'sql -> xlsx');
  finally
    props.Free;
  end;
end;

procedure TTestCoreTabular.Benchmark;
const
  ROWS = 20000;
var
  c: TCsvDocument;
  x: TXlsxDocument;
  props: TSqlDBSQLite3ConnectionProperties;
  doc, v: TDocVariantData;
  i: integer;
  bin: RawByteString;
  timer: TPrecisionTimer;
begin
  doc.InitFast(ROWS, dvArray);
  for i := 1 to ROWS do
    doc.AddItem(_ObjFast(['id', i, 'name', Make(['name ', i]), 'value', i / 7,
      'flag', odd(i), 'text', 'some "quoted", text']));
  FillCharFast(v, SizeOf(v), 0);
  c := TCsvDocument.Create([tboHeader, tboGuessTypes]);
  try
    timer.Start;
    bin := c.SaveDoc(doc);
    NotifyTestSpeed('csv write', ROWS, length(bin), @timer);
    timer.Start;
    c.Load(bin, variant(v));
    NotifyTestSpeed('csv read', ROWS, length(bin), @timer);
    CheckEqual(v.Count, ROWS, 'csv count');
    CheckEqual(_Safe(v.Values[ROWS - 2])^.ToJson, _Safe(doc.Values[ROWS - 2])^.ToJson,
      'csv row content');
  finally
    c.Free;
  end;
  x := TXlsxDocument.Create([tboHeader]);
  try
    timer.Start;
    bin := x.SaveDoc(doc);
    NotifyTestSpeed('xlsx write', ROWS, length(bin), @timer);
    v.Clear;
    timer.Start;
    x.Load(bin, variant(v));
    NotifyTestSpeed('xlsx read', ROWS, length(bin), @timer);
    CheckEqual(v.Count, ROWS, 'xlsx count');
    CheckEqual(_Safe(v.Values[ROWS - 2])^.ToJson, _Safe(doc.Values[ROWS - 2])^.ToJson,
      'xlsx row content');
  finally
    x.Free;
  end;
  props := TSqlDBSQLite3ConnectionProperties.Create(SQLITE_MEMORY_DATABASE_NAME,
    '', '', '');
  try
    timer.Start;
    CheckEqual(TabularToSqlDB(props, 'big', doc), ROWS, 'batch insert');
    NotifyTestSpeed('sql batch insert', ROWS, 0, @timer);
    timer.Start;
    CheckEqual(TabularToSqlDB(props, 'big', doc, [tsoDeleteFirst, tsoNoBatch]),
      ROWS, 'no batch insert');
    NotifyTestSpeed('sql per-row insert', ROWS, 0, @timer);
  finally
    props.Free;
  end;
end;


end.
